# Copiá este archivo como .env.local y completá los valores.
# Estas variables NO llevan prefijo NEXT_PUBLIC_: sólo existen en el servidor.

# ID del documento: está en la URL de la planilla
# https://docs.google.com/spreadsheets/d/<ESTE_ES_EL_ID>/edit
GOOGLE_SHEET_ID=

# Email de la Service Account (campo "client_email" del JSON descargado)
GOOGLE_SERVICE_ACCOUNT_EMAIL=mi-app@mi-proyecto.iam.gserviceaccount.com

# Clave privada (campo "private_key" del JSON). Entre comillas dobles y con los \n literales.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
